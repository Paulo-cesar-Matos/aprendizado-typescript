{
    "compilerOptions": {
        "esModuleInterop": true,
        "skipLibCheck": true,
        "strict": true,
        "lib": ["ESNext"],
        "target": "ESNext",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "forceConsistentCasingInFileNames": true,
        
        "rootDir": "./src",
        "outDir": "./dist",
    },
    "include": ["src"],
    "exclude": ["node_modules"]
}